	</script><script type="text/javascript" id="ct_code_block_js_506">document.addEventListener("DOMContentLoaded", function() {
  const items = document.querySelectorAll(".rank-math-list-item");

  // Open first item by default
  if (items.length > 0) items[0].classList.add("active");

  items.forEach((item) => {
    const question = item.querySelector(".rank-math-question");
    question.addEventListener("click", () => {
      // Close all other items
      items.forEach(i => {
        if (i !== item) i.classList.remove("active");
      });
      // Toggle this one
      item.classList.toggle("active");
    });
  });
});</script>
<style type="text/css" id="ct_code_block_css_506">.rank-math-block{
margin-top: 24px;
}
/* Global antialiasing for better font rendering */
#rank-math-faq,
#rank-math-faq * {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}
/* --- Accordion Styles --- */
.rank-math-block .rank-math-list-item {
  border-bottom: 1px solid #ddd;
  margin-bottom: 12px;
  overflow: hidden;
}

.rank-math-question {
  cursor: pointer;
  padding: 12px 10px;
  background: #f8f8f8;
  transition: background 0.3s ease;
  position: relative;
  font-size: 1.2rem!important;
  color: #105ee5;
}
.rank-math-question:hover {
  background: #eee;
}
.rank-math-question::after {
  content: "+";
  position: absolute;
  right: 10px;
  font-weight: bold;
  transition: transform 0.3s ease;
}
.rank-math-list-item.active .rank-math-question::after {
  content: "–";
  transform: rotate(180deg);
  
}

/* Smooth open transition */
.rank-math-answer {
  color: #888888;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease, padding 0.3s ease;
  padding: 0 10px;
  background: #fff;
}
.rank-math-list-item.active h3{
  color: #000; /* black when expanded */ 
}
.rank-math-list-item.active .rank-math-answer {
  max-height: 9999px; /* adjust if you have longer content */
}</style>
